# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for the live site.
# Setup steps: integrations/README.md

# --- Email -------------------------------------------------------------
# Where enquiries are sent. Separate several addresses with commas.
ENQUIRY_TO_EMAIL=info@kmdinterior.com

# The mailbox that sends them: info@kmdinterior.com on Google Workspace,
# with a Google *App Password* (16 characters, from
# myaccount.google.com/apppasswords while signed in as info@) — not the
# account's normal password.
SMTP_USER=info@kmdinterior.com
SMTP_PASS=

# Only needed for a non-Google mail provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Google Sheet (opens in Excel) --------------------------------------
# The Apps Script web app URL (ends in /exec), and a long random secret
# that must match SECRET in integrations/google-sheet-enquiries.gs.
ENQUIRY_SHEET_WEBHOOK_URL=
ENQUIRY_SHEET_SECRET=
